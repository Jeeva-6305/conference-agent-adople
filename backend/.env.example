# PostgreSQL Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/conference_db

# Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Celery & Redis (Optional - APScheduler runs automatically if Redis is absent)
REDIS_URL=redis://localhost:6379/0

# Automation Interval
SCRAPER_INTERVAL_MINUTES=720
REMINDER_DAYS_BEFORE=2
