# PostgreSQL Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/conference_db

# Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Celery & Redis (Optional - APScheduler runs automatically if Redis is absent)
REDIS_URL=redis://localhost:6379/0

# Automation Interval
SCRAPER_INTERVAL_MINUTES=720
REMINDER_DAYS_BEFORE=2

# Speaker Replies Configuration
SPEAKER_REPLIES_ENABLED=true
SPEAKER_REPLIES_WORKSHEET_NAME="Speakers Replies"
SPEAKER_REPLIES_TABLE_NAME=tbl_speakers_replies
SPEAKER_REPLIES_SOURCE_WORKSHEET=weekly_speakers
SPEAKER_REPLIES_SOURCE_TABLE=tbl_weekly_speakers
SPEAKER_REPLIES_APPEND_ONLY=true
SPEAKER_REPLIES_COPY_FULL_SPEAKER_ROW=true
SPEAKER_REPLIES_PRESERVE_MULTIPLE_REPLIES=true
SPEAKER_REPLIES_PREVENT_DUPLICATES=true
